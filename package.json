                            "@types/react":  "^19.2.18",
                            "@types/react-dom":  "^19.2.7",
                            "@vitejs/plugin-react":  "^6.1.1",
                            "oxlint":  "^1.81.0",
                            "playwright":  "^1.63.0",
                            "sharp":  "^0.35.5",
                            "tailwindcss":  "^4.3.3",
                            "vite":  "^8.3.0"
                        }
}
