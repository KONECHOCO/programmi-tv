                         "@capacitor/app":  "^7.1.2",
                         "@capacitor/core":  "^7.6.9",
                         "@capacitor/ios":  "^7.6.9",
                         "@capacitor/local-notifications":  "^7.0.7",
                         "@capacitor/share":  "^7.0.4",
                         "@capacitor/splash-screen":  "^7.0.5",
                         "@capacitor/status-bar":  "^7.0.6",
                         "cordova-plugin-purchase":  "^13.18.0",
                         "lucide-react":  "^1.48.0",
                         "react":  "^19.2.8",
                         "react-dom":  "^19.2.8"
                     },
    "devDependencies":  {
                            "@capacitor/assets":  "^3.0.5",
