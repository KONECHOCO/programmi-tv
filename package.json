{
    "name":  "cineguide",
    "private":  true,
    "version":  "1.0.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build",
                    "lint":  "oxlint",
                    "preview":  "vite preview",
                    "epg":  "node scripts/epg/build-epg.mjs dist/epg",
                    "epg:dev":  "node scripts/epg/build-epg.mjs .epg-cache",
                    "cap:sync":  "npm run build \u0026\u0026 cap sync",
                    "assets:generate":  "capacitor-assets generate --iconBackgroundColor \"#0b0d18\" --iconBackgroundColorDark \"#0b0d18\" --splashBackgroundColor \"#0b0d18\" --splashBackgroundColorDark \"#0b0d18\"",
                    "screenshots:store":  "node scripts/capture-store-screenshots.mjs"
                },
