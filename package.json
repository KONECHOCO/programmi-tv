{
  "name": "cineguide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "epg": "node scripts/epg/build-epg.mjs dist/epg",
    "epg:dev": "node scripts/epg/build-epg.mjs .epg-cache",
    "cap:sync": "npm run build && cap sync",
    "assets:generate": "capacitor-assets generate --iconBackgroundColor \"#0b0d18\" --iconBackgroundColorDark \"#0b0d18\" --splashBackgroundColor \"#0b0d18\" --splashBackgroundColorDark \"#0b0d18\"",
    "screenshots:store": "node scripts/capture-store-screenshots.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.4.2",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "cordova-plugin-purchase": "^13.18.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}