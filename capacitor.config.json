{
  "appId": "com.ikonet.cineguide",
  "appName": "CineGuide",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0b0d18"
  },
  "android": {
    "backgroundColor": "#0b0d18",
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": false,
      "backgroundColor": "#0b0d18",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0b0d18",
      "overlaysWebView": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_notify",
      "iconColor": "#7c6cff"
    }
  }
}
